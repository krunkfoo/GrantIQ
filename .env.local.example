# Copy to .env.local and fill in values

# Postgres — create a new database on render.com > New > PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/grantiq

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — console.cloud.google.com > New Project > APIs > OAuth 2.0 Client ID
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (local)
#                          https://grantiq.onrender.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
